# ==============================================================================
# AL TAALIM (التعليم) — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running Docker Compose or deploying to VPS:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit your real '.env' file to Git or share production secrets.
# - Generate high-entropy random strings for all passwords and JWT secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & HOST CONFIGURATION
# ------------------------------------------------------------------------------
# Active Spring Profile: 'dev' or 'prod'
SPRING_PROFILES_ACTIVE=prod

# Domain or IP address of the deployment host (used for CORS and links)
APP_URL=https://altaalim.edu

# Exposed external HTTP port (defaults to 80)
HTTP_PORT=80

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=al_taalim
DB_USER=altaalim_admin

# Generate a strong password: openssl rand -base64 24
DB_PASSWORD=ChangeThisToASecureProductionPassword123!

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT (JSON WEB TOKEN)
# ------------------------------------------------------------------------------
# 256-bit (or greater) hex/base64 secret for HMAC-SHA256 signature verification.
# Generate via: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token validity in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins
CORS_ALLOWED_ORIGINS=https://altaalim.edu,http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# 5. OPTIONAL EMAIL SMTP (FOR PASSWORD RESETS & CERTIFICATE DELIVERY)
# ------------------------------------------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=notifications@altaalim.edu
# MAIL_PASSWORD=app-specific-password-here
# MAIL_FROM=noreply@altaalim.edu
